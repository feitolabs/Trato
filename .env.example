# Copie para .env e preencha. NUNCA versione o .env.
# Só nomes aqui — sem valores reais.

# Ambiente: desenvolvimento | teste | producao
TRATO_AMBIENTE=desenvolvimento

# Supabase — projeto "Trato"
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Login no app Flutter (ver docs/login-configuracao.md). Só a chave PÚBLICA (anon/publishable).
# Use com: flutter run --dart-define-from-file=.env  (dentro de app/, com um .env só com estes quatro)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Persistência do backend: memoria (padrão, testes) | postgres (Supabase)
TRATO_PERSISTENCIA=
TRATO_PROVEDOR_PAGAMENTO=
# URL de conexão ao Postgres do Supabase (Settings > Database). Só no .env do João.
DATABASE_URL=
# Papel do Postgres usado em cada transação (padrão: service_role)
TRATO_BANCO_PAPEL=
# Validação do JWT do Supabase Auth: o segredo HS256 OU a URL das chaves públicas (JWKS)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Segredo do servidor para os códigos de check-in/check-out (gere um valor longo e aleatório)
TRATO_CODIGO_SEGREDO=

# Stripe (usar chaves de MODO TESTE até o OK do João)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# App Flutter (passados com --dart-define, não são lidos de arquivo pelo app)
# TRATO_MODO=demo        # demo (padrão, sem rede) ou api
# TRATO_API_URL=         # endereço base da API, só vale com TRATO_MODO=api

# --- Notificações e agendador (docs/backend-notificacoes.md); tudo opcional e desligado ---
# TRATO_NOTIF_DEEP_LINK_BASE=   # padrão trato://
# TRATO_NOTIF_PUSH_ATIVO=   # número/booleano: só descomente com valor
TRATO_NOTIF_FCM_PROJETO_ID=
TRATO_NOTIF_FCM_CREDENCIAIS_ARQUIVO=
# TRATO_NOTIF_APNS_ATIVO=   # número/booleano: só descomente com valor
TRATO_NOTIF_APNS_CHAVE_ARQUIVO=
TRATO_NOTIF_APNS_CHAVE_ID=
TRATO_NOTIF_APNS_TIME_ID=
TRATO_NOTIF_APNS_BUNDLE_ID=
# TRATO_NOTIF_EMAIL_ATIVO=   # número/booleano: só descomente com valor
TRATO_NOTIF_SMTP_HOST=
# TRATO_NOTIF_SMTP_PORTA=   # número/booleano: só descomente com valor
TRATO_NOTIF_SMTP_USUARIO=
TRATO_NOTIF_SMTP_SENHA=
TRATO_NOTIF_EMAIL_REMETENTE=
# TRATO_NOTIF_SMS_ATIVO=   # número/booleano: só descomente com valor
TRATO_NOTIF_SMS_PROVEDOR_URL=
TRATO_NOTIF_SMS_PROVEDOR_CHAVE=
# TRATO_AGENDADOR_INTERVALO_SEGUNDOS=
# TRATO_AGENDADOR_DIAS_CONCLUIDOS_MONITORADOS=
# TRATO_AGENDADOR_LEMBRETE_AGENDA_HORAS=

# --- App/painel (dart-define). Só nomes públicos; vão para dentro do binário. Ver docs/BUILD.md ---
# Crie app/dart-defines.json (ignorado pelo git) SÓ com: TRATO_MODO, TRATO_API_URL, SUPABASE_URL,
# SUPABASE_ANON_KEY, GOOGLE_WEB_CLIENT_ID, GOOGLE_IOS_CLIENT_ID.
# NUNCA use este .env com --dart-define-from-file (tem chaves secretas).

# Upload seguro (valores em segundos / metros; padrões no código)
# TRATO_UP_URL_ENVIO_SEGUNDOS=
# TRATO_UP_SOLICITACAO_VALIDADE_SEGUNDOS=
# TRATO_UP_CHECKIN_DISTANCIA_MAX_M=

# Cadastro e verificação do profissional (retenção dos documentos, nível por categoria em JSON)
# TRATO_PRO_VERIFICACAO_RETENCAO_DIAS=
# TRATO_PRO_VERIFICACAO_NIVEL_PADRAO=
# TRATO_PRO_VERIFICACAO_NIVEL_POR_CATEGORIA=
